{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {"source":"/","destination":"/mission-control/"},
    {"source":"/dashboard","destination":"/mission-control/"},
    {"source":"/dashboard.html","destination":"/mission-control/"},
    {"source":"/command-centre","destination":"/mission-control/"},
    {"source":"/kisan","destination":"/farmer/"}
  ],
  "headers": [
    {"source":"/(.*)","headers":[
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
      {"key":"Permissions-Policy","value":"camera=(), microphone=(self), geolocation=()"},
      {"key":"X-Frame-Options","value":"SAMEORIGIN"}
    ]},
    {"source":"/api/(.*)","headers":[{"key":"Cache-Control","value":"no-store"}]}
  ]
}
